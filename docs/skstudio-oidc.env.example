# LiteLLM Proxy · Generic OIDC → skstudio（仅 Admin UI）
# 见 litellm/docs/litellm-skstudio集成共识.md §2.1 / §6
# 生产对外基址：https://skportal.shukun.net/litellm
# 亦写入 /etc/litellm/litellm.env（见 deploy/skportal/litellm.env.example）

GENERIC_CLIENT_ID=litellm-admin-ui
GENERIC_CLIENT_SECRET=change-me-match-skstudio-LITELLM_OIDC_CLIENT_SECRET
GENERIC_AUTHORIZATION_ENDPOINT=https://skbizmgmt.shukun.net/api/v1/oidc/litellm/authorize
GENERIC_TOKEN_ENDPOINT=https://skbizmgmt.shukun.net/api/v1/oidc/litellm/token
GENERIC_USERINFO_ENDPOINT=https://skbizmgmt.shukun.net/api/v1/oidc/litellm/userinfo
GENERIC_SCOPE=openid profile
# skstudio OIDC 在 token/userinfo 发 role=proxy_admin（评审员/LLM 管理员）
GENERIC_USER_ROLE_ATTRIBUTE=role
PROXY_BASE_URL=https://skportal.shukun.net/litellm
SERVER_ROOT_PATH=/litellm
