# Mac local Proxy — copy to repo root .env:
#   cp deploy/mac/.env.example .env

LITELLM_MASTER_KEY=sk-change-me-to-a-long-random-string
LITELLM_SALT_KEY=sk-change-me-salt-also-long-random

# Native Proxy on Mac talks to compose DB on host port 5433
DATABASE_URL=postgresql://llmproxy:dbpassword9090@127.0.0.1:5433/litellm
STORE_MODEL_IN_DB=True

OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

LITELLM_PORT=4000
