# Copy to /etc/litellm/litellm.env on skportal (root:devops, 660).
# Never commit real values.

# —— secrets ——
LITELLM_MASTER_KEY=
LITELLM_SALT_KEY=
# Host Postgres (skportal 本机 postgresql@127.0.0.1:5432)；角色/库名 litellm
# publish/install 会确保角色与库存在；密码与此一致
DATABASE_URL=postgresql://litellm:REPLACE_DB_PASSWORD@127.0.0.1:5432/litellm

OPENAI_API_KEY=
OPENAI_API_BASE=

# Public base (subpath). SERVER_ROOT_PATH=/litellm + Nginx MUST preserve
# the /litellm prefix (proxy_pass without a trailing URI). Do not strip.
PROXY_BASE_URL=https://skportal.shukun.net/litellm
SERVER_ROOT_PATH=/litellm

# Generic OIDC → skstudio
GENERIC_CLIENT_ID=litellm-admin-ui
GENERIC_CLIENT_SECRET=
GENERIC_AUTHORIZATION_ENDPOINT=https://skbizmgmt.shukun.net/api/v1/oidc/litellm/authorize
GENERIC_TOKEN_ENDPOINT=https://skbizmgmt.shukun.net/api/v1/oidc/litellm/token
GENERIC_USERINFO_ENDPOINT=https://skbizmgmt.shukun.net/api/v1/oidc/litellm/userinfo
GENERIC_SCOPE="openid profile"
# skstudio OIDC claims.role → LitellmUserRoles（评审员映射 proxy_admin）
GENERIC_USER_ROLE_ATTRIBUTE=role

STORE_MODEL_IN_DB=True
